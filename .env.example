# ============================================
# Time-Off Microservice - Environment Variables
# ============================================

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=8h

# Database (SQLite)
DB_PATH=./data/timeoff.db
DB_LOGGING=false

# HCM Integration
HCM_BASE_URL=http://localhost:3001
HCM_TIMEOUT_MS=10000
HCM_MAX_RETRIES=3

# Grace Period (hours before startDate)
GRACE_PERIOD_HOURS=24
